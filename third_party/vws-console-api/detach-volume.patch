+func (c compute) DetachVolume(ctx context.Context, m backend.Mutation, req resource.DetachVolumeRequest) (resource.Accepted[resource.Volume], error) {
+	if err := ctx.Err(); err != nil {
+		return resource.Accepted[resource.Volume]{}, err
+	}
+	c.w.mu.Lock()
+	defer c.w.mu.Unlock()
+	c.w.settle(c.w.now())
+	if acc, ok, err := replay[resource.Accepted[resource.Volume]](c.w, m.Key, m.Fingerprint); err != nil || ok {
+		return acc, err
+	}
+	vol, ok := c.w.vol[req.VolumeID]
+	if !ok || vol.OwnerID != m.Account {
+		return resource.Accepted[resource.Volume]{}, resource.NotFound(resource.KindVolume, req.VolumeID.String())
+	}
+	if vol.State != resource.VolumeInUse {
+		return resource.Accepted[resource.Volume]{}, resource.Conflict(resource.KindVolume, vol.ID.String(), "volume is "+string(vol.State))
+	}
+	if !req.InstanceID.IsZero() && req.InstanceID != vol.InstanceID {
+		return resource.Accepted[resource.Volume]{}, resource.Conflict(resource.KindVolume, vol.ID.String(), "volume is not attached to "+req.InstanceID.String())
+	}
+	if req.Device != "" && req.Device != vol.Device {
+		return resource.Accepted[resource.Volume]{}, resource.Conflict(resource.KindVolume, vol.ID.String(), "volume is not attached at "+req.Device)
+	}
+	prev := *vol
+	vol.State = resource.VolumeDetaching
+	id := vol.ID
+	op, err := c.w.newOp(m.Account, resource.ServiceCompute, resource.ActionDetachVolume, []resource.Ref{id.Ref()}, func(time.Time) {
+		cur := c.w.vol[id]
+		if cur != nil && cur.State == resource.VolumeDetaching {
+			cur.State = resource.VolumeAvailable
+			cur.InstanceID = resource.InstanceID{}
+			cur.Device = ""
+		}
+	})
+	if err != nil {
+		*vol = prev
+		return resource.Accepted[resource.Volume]{}, err
+	}
+	item := *vol
+	acc := resource.Accepted[resource.Volume]{Operation: op, Items: []resource.Volume{item}}
+	c.w.finish(m.Key, m.Fingerprint, acc)
+	return acc, nil
+}
